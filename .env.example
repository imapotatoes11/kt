# Copy to .env.local (local) or add as Vercel environment variables (deployed).

# --- Required ---------------------------------------------------------------

# Neon Postgres connection string (https://neon.com). Until this is set the app
# loads, but every data view is disabled and shows setup instructions. The
# required table is created automatically on first use.
DATABASE_URL=

# Shared access key(s) for signing in. Add more with APP_ACCESS_KEYS (comma-separated).
APP_ACCESS_KEY=
APP_ACCESS_KEYS=

# --- Optional ---------------------------------------------------------------

# Display name used in the page title, installed-app name, and sidebar.
APP_NAME=Timetable

# Profiles, as comma-separated id:Name pairs. ids are lowercase letters, digits, - or _.
# Everyone who has an access key can switch between all profiles.
APP_PROFILES=me:Me

# Secret that protects the daily cron route (Vercel sends it automatically).
CRON_SECRET=

# Defaults applied to new profiles.
DEFAULT_TIMEZONE=America/Toronto
DEFAULT_ORIGIN_LABEL=Campus entrance
DEFAULT_ORIGIN_LATITUDE=43.6532
DEFAULT_ORIGIN_LONGITUDE=-79.3832

# ntfy push notifications. NTFY_TOPIC seeds the first profile; NTFY_TOPIC_<ID>
# (upper-cased, "-" becomes "_") seeds a specific one. Topics can also be set in the app.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
# NTFY_TOPIC_ME=
